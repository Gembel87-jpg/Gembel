// LOCAL REPLACEMENTS — all helper logic is defined inside this script.
// These helpers intentionally keep behavior transparent and editable.
// ---------------------------------------------------------------------------
f_mbel_line_style(string styleText) =>
    styleText == "----" ? line.style_dashed : styleText == "...." ? line.style_dotted : line.style_solid

f_mbel_norm_tf(string tf) =>
    tf == "1D" ? "D" : tf == "1W" ? "W" : tf == "1M" ? "M" : tf

f_mbel_tf_seconds(string tf) =>
    string normalized = f_mbel_norm_tf(tf)
    str.length(normalized) > 0 ? timeframe.in_seconds(normalized) : na

f_mbel_htf_runtime_bars(string tf, int count, int chartSec, int maxBars) =>
    int tfSec = f_mbel_tf_seconds(tf)
    int rawBars = not na(tfSec) and chartSec > 0 ? int(math.ceil(float(tfSec) * count / chartSec)) + 2 : maxBars
    math.max(1, math.min(rawBars, maxBars))

f_mbel_runtime_on(int barsBack, int calcBars, int barIndex, int lastBarIndex) =>
    not na(barsBack) and barIndex >= lastBarIndex - calcBars and barsBack <= calcBars

f_mbel_htf_runtime_on(string tf, int count, int chartSec, int maxBars, int calcBars, int barIndex, int lastBarIndex) =>
    int neededBars = f_mbel_htf_runtime_bars(tf, count, chartSec, maxBars)
    int windowBars = math.min(maxBars, math.max(calcBars, neededBars))
    barIndex >= lastBarIndex - windowBars

f_mbel_auto_tf(int chartSec, int pane) =>
    string tf = ""
    if chartSec == 60
        tf := pane == 1 ? "5" : pane == 2 ? "15" : pane == 3 ? "60" : ""
    else if chartSec == 180
        tf := pane == 1 ? "30" : pane == 2 ? "60" : pane == 3 ? "240" : ""
    else if chartSec == 300
        tf := pane == 1 ? "15" : pane == 2 ? "60" : pane == 3 ? "240" : ""
    else if chartSec == 900 or chartSec == 1800
        tf := pane == 1 ? "60" : pane == 2 ? "240" : pane == 3 ? "1D" : ""
    else if chartSec == 3600
        tf := pane == 1 ? "240" : pane == 2 ? "1D" : pane == 3 ? "1W" : ""
    else if chartSec == 14400
        tf := pane == 1 ? "1D" : pane == 2 ? "1W" : pane == 3 ? "1M" : ""
    tf

f_mbel_panel_label(string tf) =>
    string normalized = f_mbel_norm_tf(tf)
    int sec = f_mbel_tf_seconds(normalized)
    string out = normalized
    if not na(sec)
        if sec < 60
            out := str.tostring(sec) + "s"
        else if sec < 3600
            out := str.tostring(int(sec / 60)) + "m"
        else if sec < 86400
            out := str.tostring(int(sec / 3600)) + "H"
        else if normalized == "D"
            out := "1D"
        else if normalized == "W"
            out := "1W"
        else if normalized == "M"
            out := "1M"
        else if normalized == "12M"
            out := "1Y"
    out

f_mbel_smt_rank_enabled(int rank) =>
    rank == 1 ? smt_15m_show : rank == 2 ? smt_30m_show : rank == 3 ? smt_1h_show : rank == 4 ? smt_90m_show : rank == 5 ? smt_4h_show : rank == 6 ? smt_6h_show : rank == 7 ? smt_7h_show : rank == 8 ? smt_12h_show : rank == 9 ? smt_1d_show : rank == 10 ? smt_1w_show : rank == 11 ? smt_1m_show : rank == 12 ? smt_3m_show : rank == 13 ? smt_12m_show : false

f_mbel_smt_stacked_label(string shortname, string pairName) =>
    pairName == "" ? shortname : shortname + "\n" + pairName

f_mbel_smt_label_price(int direction, float y1, float y2, float tick) =>
    direction > 0 ? math.min(y1, y2) - tick * 2.0 : math.max(y1, y2) + tick * 2.0

// Normalize 1D / 1W / 1M spellings for Pine timeframe functions
normTf(string tf) =>
    tf == '1D' ? 'D' : tf == '1W' ? 'W' : tf == '1M' ? 'M' : tf
tfSec(string tf) =>
    str.length(tf) > 0 ? timeframe.in_seconds(tf) : na
// ── Local runtime gates ──
htfRuntimeBars(string tf, int count) =>
    f_mbel_htf_runtime_bars(tf, count, chart_sec, PERF_HTF_MAX_BARS)
// Feature window capped by Calculated Bars
runtimeOn(int barsBack) =>
    f_mbel_runtime_on(barsBack, calc_bars_input, bar_index, last_bar_index)
// HTF window: at least Calculated Bars, extended to fill 'count' HTF candles
htfRuntimeOn(string tf, int count) =>
    f_mbel_htf_runtime_on(tf, count, chart_sec, PERF_HTF_MAX_BARS, calc_bars_input, bar_index, last_bar_index)
