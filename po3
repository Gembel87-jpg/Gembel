    string dow
    // Visual positions (calculated during draw)
    int candle_left
    int candle_right
    int wick_x
    // HTF panel SMT / PSP flags (recomputed on the last bar)
    bool smt_bull = false
    bool smt_bear = false
    bool psp = false

// One pair candle aligned to an HTF candle (same open time)
type HtfPairCandle
    float o
    float h
    float l
    float c
    int   ot
    bool  is_closed = false

type Trace
    int start_idx
    float start_price


type Sweep
    float price
    int ltf_index
    int htf_candle_idx
    int swept_candle_idx
    int ltf_end_idx
    bool is_high  // true = high sweep, false = low sweep

// Completed IC-CISD (confirmed only)
type ICCisd
    float level
    int start_idx
    int end_idx
    float extreme_price
    int extreme_idx
    bool taken               // wick beyond swing high/low — line and dot go grey

type Setup
    bool is_bullish          // true = bullish setup (low sweep), false = bearish (high sweep)
    bool is_confirmed        // true when sweep is confirmed (close in range)
    bool is_post_c2          // true after C2 closes, waiting for CISD
    // Sweep data
    float sweep_price        // swept high/low price (C1 high/low)
    int sweep_ltf_idx        // LTF bar index of sweep
    int sweep_bar_idx        // bar index where sweep happened (for CISD traceback)
    int swept_candle_idx     // HTF candle that was swept (o_idx)
    int htf_candle_idx       // HTF candle that did the sweeping
    int ltf_end_idx          // LTF end point for sweep line
    int htf_count            // counts HTF candles since sweep (max 2)
    // C2 data
    int c2_x                 // bar index for C2 label (at swing point)
    float c2_y               // price for C2 label (swing high/low)
    float c2_extreme         // C2's high (bearish) or low (bullish) for price limit
    // CISD data
    float cisd_level         // CISD price level (open of opposing candles)
    int cisd_start_idx       // bar index where CISD level starts
    int cisd_end_idx         // body-break bar; line drawn to this + 1
    float tracked_extreme    // tracks high/low price for CISD (lowest low or highest high)
    int extreme_bar_idx      // bar index where the extreme occurred (for CISD traceback)
    bool has_cisd            // true when CISD level is set
    bool cisd_triggered      // true when CISD may show (body broke; in C2 also needs sweep back in)
    // IC-CISD (rebuild): opposite-candle open = level; body break confirms; one pending
    array<ICCisd> ic_list
    bool ic_active           // detection on after main CISD (through C4)
    bool ic_pending          // waiting for body break on current structure
    float ic_level           // open of opposite candle
    int ic_start_idx         // bar of that opposite candle
    float ic_extreme         // running high (bear) / low (bull) for dot — update every bar until confirm
    int ic_extreme_idx
    bool ic_seen_same_side   // true only after a real same-side candle (not doji) while pending
    float ic_last_extreme    // last confirmed IC swing extreme — next arm only if exceeds this (higher high / lower low)
    // Projection data
    float proj_anchor_1      // Point "1" - swing high (bearish) or swing low (bullish)
    float proj_anchor_0      // Point "0" - CISD candle's low (bearish) or high (bullish)
    int proj_start_idx       // Bar index where projection starts (swing point)
    int proj_end_idx         // Bar index where projection ends (CISD trigger bar)
    // Liquidity data
    float liq_c1_price       // C1 low (bearish) or high (bullish)
    int liq_c1_start_idx     // LTF bar index where C1 low/high occurred
    float liq_c0_price       // C0 low (bearish) or high (bullish) - na if condition not met
    int liq_c0_start_idx     // LTF bar index where C0 low/high occurred
    int liq_end_time         // C4's end time (for extending lines)
    int liq_c1_mitigated_idx // Bar index where C1 liq was crossed (na if not mitigated)
    int liq_c0_mitigated_idx // Bar index where C0 liq was crossed (na if not mitigated)
    // Invalidation
    bool is_invalid          // True if C3 exceeded C2 extreme after CISD triggered
    // Entry Zone C3 data
    float c2_mid             // C2 wick midpoint (high+low)/2
    float c3_open            // C3 open price
    bool ez_c3_set           // true when C3 entry zone bounds are calculated
    float ez_c3_top          // C3 zone top price
    float ez_c3_bot          // C3 zone bottom price
    int ez_c3_left_time      // C3 zone left (C3 open time)
    int ez_c3_right_time     // C3 zone right (C3 close / C4 open); na while C3 is live
    // Entry Zone C4 data
    float c3_mid             // C3 wick midpoint (high+low)/2
    float c3_extreme         // C3 high (bearish) or low (bullish) for C4 invalidation
    float c4_open            // C4 open price
    bool ez_c4_set           // true when C4 entry zone bounds are calculated
    bool ez_c4_invalid       // true when C4 invalidated (beyond C3 extreme)
    int ez_c4_invalid_time   // LTF time where C4 was invalidated (EQ stops here)
    float ez_c4_top          // C4 zone top price
    float ez_c4_bot          // C4 zone bottom price
    int ez_c4_left_time      // C4 zone left (C4 open time)
    int ez_c4_right_time     // C4 zone right (C4 close)
    // SMT data
    bool has_smt             // SMT detected for this setup
    int smt_x1               // SMT line start bar index
    int smt_x2               // SMT line end bar index
    float smt_y1             // SMT line start price
    float smt_y2             // SMT line end price
    string smt_symbol        // Which symbol triggered SMT (for label)

