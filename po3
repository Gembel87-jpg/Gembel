// Panel C-labels (Profiler style): latest formation only — C1 swept candle, C2, C3, C4
PanelCLabel(Candle c, string txt, bool bull, color col) =>
    bool dow_same_side = settings.daily_name and c.dow != '' and (settings.dow_position == 'Both' or (bull ? settings.dow_position == 'Bottom' : settings.dow_position == 'Top'))
    float pad = math.max(math.abs(c.h - c.l) * 0.012, syminfo.mintick * 3)
    bin.labels.push(label.new(c.wick_x, bull ? c.l - pad : c.h + pad, dow_same_side ? (bull ? '\n' + txt : txt + '\n') : txt, color = color_transparent, textcolor = col, style = bull ? label.style_label_up : label.style_label_down, size = settings.c2_size, text_font_family = font.family_monospace))

// C1–C4 labels around the C2 at index best of a panel (C1 = the candle before it); dot = the table's
// confirmed C2 → a green ● right after its text (no-break spaces keep the padding, monospace)
PanelCLabelsAt(array<Candle> arr, int best, bool bull, bool dot) =>
    if best >= 0
        for j = 1 to -2
            int idx = best + j
            if idx >= 0 and idx < arr.size() and (j >= 0 ? settings.show_c2_lbl : j == -1 ? settings.show_c3_lbl : settings.show_c4_lbl)
                string t = j == 1 ? 'C1' : j == 0 ? 'C2' + PspTag(arr, best) : 'C' + str.tostring(2 - j)
                for k = 0 to (j == 0 and dot ? 1 : 0)
                    PanelCLabel(arr.get(idx), k == 0 ? t : str.repeat(' ', str.length(t) + (pnl_dot_size == 'Large' ? 4 : 3)) + (pnl_dot_size == 'Small' ? '•' : pnl_dot_size == 'Large' ? '⬤' : '●'), bull, k == 0 ? settings.c2_color : pnl_dot_color)
    0

// C1–C4 labels on every HTF panel (model panel included): the latest C1 → C2 sweep that is still
// standing, forming C2 included (live sweep) — same rule as the panel sweep lines. Uses the C2 / C3 / C4
// toggles, label color / size and 'C-Labels On' (Panel / Both); on = 'C1–C4 on Other Panels' for the
// panels that do not host the model.
var array<int> NO_HIST = array.new<int>()
// hist: confirmed C2s (open time, + bull / - bear), hMs = their candle length → the ● dot on a labelled C2
DrawPanelCLabelsPreview(array<Candle> arr, bool on, array<int> hist, int hMs, bool fBull, int force) =>
    int n = arr.size()
    if c_lbl_panel and on and not settings.hide_setups and n >= 2
        int best = force
        bool best_bull = fBull
        if force < 0
            for i = 0 to n - 2
                Candle c2 = arr.get(i)
                Candle c1 = arr.get(i + 1)
                bool bear = c2.h > c1.h and c2.c < c1.h and (settings.bias == 'Neutral' or settings.bias == 'Bearish')
                bool bull = c2.l < c1.l and c2.c > c1.l and (settings.bias == 'Neutral' or settings.bias == 'Bullish')
                if i > 0
                    for k = 0 to i - 1
                        Candle nw = arr.get(k)
                        bear := bear and not (nw.h > c2.h)
                        bull := bull and not (nw.l < c2.l)
                if (i > 0 or settings.sweep_live) and (bear or bull)
                    best := i
                    best_bull := bull and bear ? c2.c > c2.o : bull
                    break
        bool dot = false
        if best >= 0
            int ot = arr.get(best).o_time
            for t in hist
                dot := dot or (math.abs(t) <= ot and ot < math.abs(t) + hMs and (t > 0) == best_bull)
        PanelCLabelsAt(arr, best, best_bull, dot)
    0


