// ============================================================================

var line[]   prg_ln    = array.new_line()
var label[]  prg_lb    = array.new_label()
var float[]  prg_price = array.new_float()
var int[]    prg_prio  = array.new_int()
var color[]  prg_color = array.new_color()
var int[]    prg_time  = array.new_int()

f_prg_trim() =>
    while array.size(prg_ln) > lq_max_purged
        line del_ln = array.shift(prg_ln)
        label del_lb = array.shift(prg_lb)
        array.shift(prg_price)
        array.shift(prg_prio)
        array.shift(prg_color)
        array.shift(prg_time)
        if not na(del_ln)
            line.delete(del_ln)
        if not na(del_lb)
            label.delete(del_lb)

f_touch_mark(float price, int prio, int crtime) =>
    label xl = na
    if lq_purge_cross
        xl := label.new(time, price, "✕", xloc=xloc.bar_time, color=color.new(color.black, 100), textcolor=lq_purged_color, style=label.style_label_left, size=size.tiny)
    array.push(prg_ln, na)
    array.push(prg_lb, xl)
    array.push(prg_price, price)
    array.push(prg_prio, prio)
    array.push(prg_color, lq_purged_color)
    array.push(prg_time, crtime)
    f_prg_trim()

f_purge_level(line ln, label lb, float lvl, color clr, int prio, int crtime) =>
    if not na(ln)
        if lq_del_purged
            line.delete(ln)
            if not na(lb)
                label.delete(lb)
        else
            line.set_color(ln, lq_purged_color)
            line.set_style(ln, lq_f_style(lq_purged_style))
            line.set_x2(ln, time)
            if not na(lb)
                label.delete(lb)
            label xl = na
            if lq_purge_cross
                xl := label.new(time, lvl, "✕", xloc=xloc.bar_time, color=color.new(color.black, 100), textcolor=lq_purged_color, style=label.style_label_left, size=size.tiny)
            array.push(prg_ln, ln)
            array.push(prg_lb, xl)
            array.push(prg_price, lvl)
            array.push(prg_prio, prio)
            array.push(prg_color, lq_purged_color)
            array.push(prg_time, crtime)
            f_prg_trim()

