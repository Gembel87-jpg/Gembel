method DrawSetups(CandleSet candleSet) =>
    sweep_line_style = LineStyle(settings.sweep_style)
    cisd_line_style = LineStyle(settings.cisd_style)
    if candleSet.setups.size() > 0
        int non_visible_count = 0
        int total_count = 0
        for [i, setup] in candleSet.setups
            if not setup.is_confirmed
                continue
            bool bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and setup.is_bullish) or (settings.bias == 'Bearish' and not setup.is_bullish)
            if not bias_ok
                continue
            bool is_visible = false
            for [j, candle] in candleSet.candles
                if candle.o_idx == setup.htf_candle_idx
                    is_visible := true
                    break
            bool should_draw = false
            if settings.sweep_visible_only
                if is_visible
                    should_draw := true
                else if non_visible_count < settings.sweep_history
                    should_draw := true
                    non_visible_count := non_visible_count + 1
            else
                if total_count < settings.sweep_history
                    should_draw := true
                    total_count := total_count + 1
            if should_draw
                if not setup.is_invalid and settings.liq_show and setup.cisd_triggered and not na(setup.liq_c1_price) and not na(setup.liq_end_time)
                    liq_line_style = LineStyle(settings.liq_style)
                    int c1_start_time = time[bar_index - setup.liq_c1_start_idx]
                    int c1_end_time = na
                    if not na(setup.liq_c1_mitigated_idx)
                        c1_end_time := time[bar_index - setup.liq_c1_mitigated_idx]
                    else if time < setup.liq_end_time
                        c1_end_time := time
                    else
                        c1_end_time := setup.liq_end_time
                    bin.lines.push(line.new(c1_start_time, setup.liq_c1_price, c1_end_time, setup.liq_c1_price, xloc = xloc.bar_time, color = settings.liq_color, style = liq_line_style, width = settings.liq_width))
                    if not na(setup.liq_c0_price)
                        int c0_start_time = time[bar_index - setup.liq_c0_start_idx]
                        int c0_end_time = na
                        if not na(setup.liq_c0_mitigated_idx)
                            c0_end_time := time[bar_index - setup.liq_c0_mitigated_idx]
                        else if time < setup.liq_end_time
                            c0_end_time := time
                        else
                            c0_end_time := setup.liq_end_time
                        bin.lines.push(line.new(c0_start_time, setup.liq_c0_price, c0_end_time, setup.liq_c0_price, xloc = xloc.bar_time, color = settings.liq_color, style = liq_line_style, width = settings.liq_width))
                if not setup.is_invalid and settings.proj_show and setup.cisd_triggered and not na(setup.proj_anchor_1) and not na(setup.proj_anchor_0)
                    proj_line_style = LineStyle(settings.proj_style)
                    proj_label_sz = LabelSize(settings.proj_label_size)
                    float proj_range = setup.proj_anchor_1 - setup.proj_anchor_0
                    for dv = 0 to proj_deviations.size() - 1
                        dev = proj_deviations.get(dv)
                        float price = na
                        if setup.is_bullish
                            price := setup.proj_anchor_0 - (math.abs(proj_range) * dev)
                        else
                            price := setup.proj_anchor_0 + (proj_range * dev)
                        bin.lines.push(line.new(setup.proj_start_idx, price, setup.proj_end_idx, price, color = settings.proj_color, style = proj_line_style, width = settings.proj_width))
                        if settings.proj_label_show
                            bin.labels.push(label.new(setup.proj_start_idx, price, str.tostring(dev), color = color_transparent, textcolor = settings.proj_color, style = label.style_label_right, size = proj_label_sz))
                if settings.show_c2_lbl
                    lbl_style = setup.is_bullish ? label.style_label_up : label.style_label_down
                    string lbl_text = setup.is_invalid ? "xC2" : "C2"
                    color lbl_color = setup.is_invalid ? color.red : settings.c2_color
                    bin.labels.push(label.new(setup.c2_x, setup.c2_y, lbl_text, color = color_transparent, textcolor = lbl_color, style = lbl_style, size = settings.c2_size))
                if not setup.is_invalid and settings.sweep_show
                    bin.lines.push(line.new(setup.sweep_ltf_idx, setup.sweep_price, setup.ltf_end_idx, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
                if not setup.is_invalid and not settings.hide_candles
                    int htf_x1 = na
                    int htf_x2 = na
                    for [k, candle] in candleSet.candles
                        if candle.o_idx == setup.swept_candle_idx
                            htf_x1 := candle.wick_x
                        if candle.o_idx == setup.htf_candle_idx
                            htf_x2 := candle.candle_right
                    if not na(htf_x1) and not na(htf_x2)
                        if settings.sweep_show
                            bin.lines.push(line.new(htf_x1, setup.sweep_price, htf_x2, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
                if settings.cisd_show and setup.cisd_triggered and setup.has_cisd
                    cisd_color = setup.is_bullish ? settings.cisd_bull_color : settings.cisd_bear_color
                    bin.lines.push(line.new(setup.cisd_start_idx, setup.cisd_level, setup.cisd_end_idx + 1, setup.cisd_level, color = cisd_color, style = cisd_line_style, width = settings.cisd_width))
                if settings.ic_cisd_show and setup.cisd_triggered and not na(setup.ic_list) and setup.ic_list.size() > 0
                    for ic_i = 0 to setup.ic_list.size() - 1
                        ICCisd ic = setup.ic_list.get(ic_i)
                        color ic_col = ic.taken ? color.gray : (setup.is_bullish ? settings.cisd_bull_color : settings.cisd_bear_color)
                        if not na(ic.level) and not na(ic.start_idx) and not na(ic.end_idx)
                            bin.lines.push(line.new(ic.start_idx, ic.level, ic.end_idx, ic.level, color = ic_col, style = cisd_line_style, width = settings.cisd_width))
                        if not na(ic.extreme_price) and not na(ic.extreme_idx)
                            ic_dot_style = setup.is_bullish ? label.style_label_up : label.style_label_down
                            bin.labels.push(label.new(ic.extreme_idx, ic.extreme_price, "●", color = color_transparent, textcolor = ic_col, style = ic_dot_style, size = settings.ic_dot_size))
                if not setup.is_invalid and setup.is_confirmed and ShowChartEQ()
                    eq_line_style = LineStyle(prev_eq_style)
                    if not na(setup.c2_mid) and not na(setup.ez_c3_left_time)
                        int eq3_right = EntryZoneRight(setup.ez_c3_right_time)
                        if eq3_right > setup.ez_c3_left_time
                            bin.lines.push(line.new(setup.ez_c3_left_time, setup.c2_mid, eq3_right, setup.c2_mid, xloc = xloc.bar_time, color = prev_eq_color, style = eq_line_style, width = prev_eq_width))
                    if not na(setup.c3_mid) and not na(setup.ez_c4_left_time)
                        int eq4_right = setup.ez_c4_invalid and not na(setup.ez_c4_invalid_time) ? setup.ez_c4_invalid_time : EntryZoneRight(setup.ez_c4_right_time)
                        color eq4_col = setup.ez_c4_invalid ? color.red : prev_eq_color
                        if eq4_right > setup.ez_c4_left_time
                            bin.lines.push(line.new(setup.ez_c4_left_time, setup.c3_mid, eq4_right, setup.c3_mid, xloc = xloc.bar_time, color = eq4_col, style = eq_line_style, width = prev_eq_width))
                if not setup.is_invalid and setup.is_confirmed and ShowHtfEQ() and not settings.hide_candles
                    int c2_i = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
                    eq_htf_style = LineStyle(prev_eq_style)
                    if not na(setup.c2_mid) and c2_i > 0
                        Candle c2_proj = candleSet.candles.get(c2_i)
                        Candle c3_proj = candleSet.candles.get(c2_i - 1)
                        int htf_eq3_x1 = c2_proj.wick_x
                        int htf_eq3_x2 = c3_proj.candle_right + 2
                        if htf_eq3_x2 > htf_eq3_x1
                            bin.lines.push(line.new(htf_eq3_x1, setup.c2_mid, htf_eq3_x2, setup.c2_mid, color = prev_eq_color, style = eq_htf_style, width = prev_eq_width))
                    if not na(setup.c3_mid) and c2_i > 1
                        Candle c3_proj4 = candleSet.candles.get(c2_i - 1)
                        Candle c4_proj = candleSet.candles.get(c2_i - 2)
                        int htf_eq4_x1 = c3_proj4.wick_x
                        int htf_eq4_x2 = c4_proj.candle_right + 2
                        color htf_eq4_col = setup.ez_c4_invalid ? color.red : prev_eq_color
                        if htf_eq4_x2 > htf_eq4_x1
                            bin.lines.push(line.new(htf_eq4_x1, setup.c3_mid, htf_eq4_x2, setup.c3_mid, color = htf_eq4_col, style = eq_htf_style, width = prev_eq_width))
                if not setup.is_invalid and settings.entry_zone_show and setup.ez_c3_set and not na(setup.ez_c3_left_time)
                    color ez_col = setup.is_bullish ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
                    int ez_right = EntryZoneRight(setup.ez_c3_right_time)
                    bin.boxes.push(box.new(setup.ez_c3_left_time, setup.ez_c3_top, ez_right, setup.ez_c3_bot, xloc = xloc.bar_time, bgcolor = ez_col, border_color = color_transparent, border_width = 0))
                    if settings.show_c3_lbl
                        float ez_lbl_y = setup.is_bullish ? setup.ez_c3_bot : setup.ez_c3_top
                        int ez_lbl_x = setup.ez_c3_left_time + timeframe.in_seconds() * 1000
                        lbl_style_ez = setup.is_bullish ? label.style_label_up : label.style_label_down
                        bin.labels.push(label.new(ez_lbl_x, ez_lbl_y, "C3", xloc = xloc.bar_time, color = color_transparent, textcolor = settings.c2_color, style = lbl_style_ez, size = settings.c2_size))
                if not setup.is_invalid and settings.entry_zone_show and setup.ez_c4_set and not na(setup.ez_c4_left_time)
                    color ez4_col = setup.is_bullish ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
                    int ez4_right = EntryZoneRight(setup.ez_c4_right_time)
                    if not setup.ez_c4_invalid
                        bin.boxes.push(box.new(setup.ez_c4_left_time, setup.ez_c4_top, ez4_right, setup.ez_c4_bot, xloc = xloc.bar_time, bgcolor = ez4_col, border_color = color_transparent, border_width = 0))
                    if settings.show_c4_lbl
                        float ez4_lbl_y = setup.is_bullish ? setup.ez_c4_bot : setup.ez_c4_top
                        int ez4_lbl_x = setup.ez_c4_left_time + timeframe.in_seconds() * 1000
                        string ez4_txt = setup.ez_c4_invalid ? "xC4" : "C4"
                        color ez4_lbl_col = setup.ez_c4_invalid ? color.red : settings.c2_color
                        lbl_style_ez4 = setup.is_bullish ? label.style_label_up : label.style_label_down
                        bin.labels.push(label.new(ez4_lbl_x, ez4_lbl_y, ez4_txt, xloc = xloc.bar_time, color = color_transparent, textcolor = ez4_lbl_col, style = lbl_style_ez4, size = settings.c2_size))
    // Draw live setups
    for is_bull in array.from(false, true)
        bool bias_ok = settings.bias == 'Neutral' or (settings.bias == 'Bullish' and is_bull) or (settings.bias == 'Bearish' and not is_bull)
        if not bias_ok
            continue
        bool has_live = is_bull ? candleSet.has_live_bullish : candleSet.has_live_bearish
        if not has_live
            continue
        setup = is_bull ? candleSet.live_bullish : candleSet.live_bearish
        if settings.sweep_live
            if not (setup.is_confirmed or setup.is_post_c2)
                continue
        else
            if not (setup.is_post_c2 and setup.cisd_triggered)
                continue
        if not setup.is_invalid and settings.liq_show and setup.cisd_triggered and not na(setup.liq_c1_price)
            liq_line_style = LineStyle(settings.liq_style)
            int c1_start_time = time[bar_index - setup.liq_c1_start_idx]
            int c1_end_time = not na(setup.liq_c1_mitigated_idx) ? time[bar_index - setup.liq_c1_mitigated_idx] : time
            bin.lines.push(line.new(c1_start_time, setup.liq_c1_price, c1_end_time, setup.liq_c1_price, xloc = xloc.bar_time, color = settings.liq_color, style = liq_line_style, width = settings.liq_width))
            if not na(setup.liq_c0_price)
                int c0_start_time = time[bar_index - setup.liq_c0_start_idx]
                int c0_end_time = not na(setup.liq_c0_mitigated_idx) ? time[bar_index - setup.liq_c0_mitigated_idx] : time
                bin.lines.push(line.new(c0_start_time, setup.liq_c0_price, c0_end_time, setup.liq_c0_price, xloc = xloc.bar_time, color = settings.liq_color, style = liq_line_style, width = settings.liq_width))
        if not setup.is_invalid and settings.proj_show and setup.cisd_triggered and not na(setup.proj_anchor_1) and not na(setup.proj_anchor_0)
            proj_line_style = LineStyle(settings.proj_style)
            proj_label_sz = LabelSize(settings.proj_label_size)
            float proj_range = setup.proj_anchor_1 - setup.proj_anchor_0
            for dv = 0 to proj_deviations.size() - 1
                dev = proj_deviations.get(dv)
                float price = na
                if is_bull
                    price := setup.proj_anchor_0 - (math.abs(proj_range) * dev)
                else
                    price := setup.proj_anchor_0 + (proj_range * dev)
                bin.lines.push(line.new(setup.proj_start_idx, price, setup.proj_end_idx, price, color = settings.proj_color, style = proj_line_style, width = settings.proj_width))
                if settings.proj_label_show
                    bin.labels.push(label.new(setup.proj_start_idx, price, str.tostring(dev), color = color_transparent, textcolor = settings.proj_color, style = label.style_label_right, size = proj_label_sz))
        if settings.show_c2_lbl and setup.is_post_c2 and setup.cisd_triggered
            lbl_style = is_bull ? label.style_label_up : label.style_label_down
            string lbl_text = setup.is_invalid ? "xC2" : "C2"
            color lbl_color = setup.is_invalid ? color.red : settings.c2_color
            bin.labels.push(label.new(setup.c2_x, setup.c2_y, lbl_text, color = color_transparent, textcolor = lbl_color, style = lbl_style, size = settings.c2_size))
        if not setup.is_invalid and settings.sweep_show
            int sweep_end = setup.is_post_c2 ? setup.ltf_end_idx : bar_index
            bin.lines.push(line.new(setup.sweep_ltf_idx, setup.sweep_price, sweep_end, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
        if not setup.is_invalid and not settings.hide_candles
            int htf_x1 = na
            int htf_x2 = na
            for [j, candle] in candleSet.candles
                if candle.o_idx == setup.swept_candle_idx
                    htf_x1 := candle.wick_x
                if candle.o_idx == setup.htf_candle_idx
                    htf_x2 := candle.candle_right
            if not na(htf_x1) and not na(htf_x2)
                if settings.sweep_show
                    bin.lines.push(line.new(htf_x1, setup.sweep_price, htf_x2, setup.sweep_price, color = settings.sweep_color, style = sweep_line_style, width = settings.sweep_size))
        if not setup.is_invalid and settings.early_cisd_show and setup.has_cisd and not setup.cisd_triggered
            early_cisd_line_style = LineStyle(settings.early_cisd_style)
            int early_end = na(setup.cisd_end_idx) ? bar_index : setup.cisd_end_idx
            bin.lines.push(line.new(setup.cisd_start_idx, setup.cisd_level, early_end, setup.cisd_level, color = settings.early_cisd_color, style = early_cisd_line_style, width = settings.cisd_width))
            if settings.show_c2_lbl
                lbl_style_early = is_bull ? label.style_label_up : label.style_label_down
                bin.labels.push(label.new(early_end, setup.cisd_level, is_bull ? '+CISD' : '-CISD', color = color_transparent, textcolor = settings.early_cisd_color, style = lbl_style_early, size = settings.c2_size))
        if settings.cisd_show and setup.cisd_triggered and setup.has_cisd
            cisd_color = is_bull ? settings.cisd_bull_color : settings.cisd_bear_color
            bin.lines.push(line.new(setup.cisd_start_idx, setup.cisd_level, setup.cisd_end_idx + 1, setup.cisd_level, color = cisd_color, style = cisd_line_style, width = settings.cisd_width))
        if settings.ic_cisd_show and setup.cisd_triggered and not na(setup.ic_list) and setup.ic_list.size() > 0
            for ic_j = 0 to setup.ic_list.size() - 1
                ICCisd ic_l = setup.ic_list.get(ic_j)
                color ic_col_l = ic_l.taken ? color.gray : (is_bull ? settings.cisd_bull_color : settings.cisd_bear_color)
                if not na(ic_l.level) and not na(ic_l.start_idx) and not na(ic_l.end_idx)
                    bin.lines.push(line.new(ic_l.start_idx, ic_l.level, ic_l.end_idx, ic_l.level, color = ic_col_l, style = cisd_line_style, width = settings.cisd_width))
                if not na(ic_l.extreme_price) and not na(ic_l.extreme_idx)
                    ic_dot_style_l = is_bull ? label.style_label_up : label.style_label_down
                    bin.labels.push(label.new(ic_l.extreme_idx, ic_l.extreme_price, "●", color = color_transparent, textcolor = ic_col_l, style = ic_dot_style_l, size = settings.ic_dot_size))
        if not setup.is_invalid and setup.is_confirmed and ShowChartEQ()
            eq_line_style_live = LineStyle(prev_eq_style)
            if not na(setup.c2_mid) and not na(setup.ez_c3_left_time)
                int eq3_right_live = EntryZoneRight(setup.ez_c3_right_time)
                if eq3_right_live > setup.ez_c3_left_time
                    bin.lines.push(line.new(setup.ez_c3_left_time, setup.c2_mid, eq3_right_live, setup.c2_mid, xloc = xloc.bar_time, color = prev_eq_color, style = eq_line_style_live, width = prev_eq_width))
            if not na(setup.c3_mid) and not na(setup.ez_c4_left_time)
                int eq4_right_live = setup.ez_c4_invalid and not na(setup.ez_c4_invalid_time) ? setup.ez_c4_invalid_time : EntryZoneRight(setup.ez_c4_right_time)
                color eq4_col_live = setup.ez_c4_invalid ? color.red : prev_eq_color
                if eq4_right_live > setup.ez_c4_left_time
                    bin.lines.push(line.new(setup.ez_c4_left_time, setup.c3_mid, eq4_right_live, setup.c3_mid, xloc = xloc.bar_time, color = eq4_col_live, style = eq_line_style_live, width = prev_eq_width))
        if not setup.is_invalid and setup.is_confirmed and ShowHtfEQ() and not settings.hide_candles
            int c2_i_live = FindCandleIndex(candleSet.candles, setup.htf_candle_idx)
            eq_htf_style_live = LineStyle(prev_eq_style)
            if not na(setup.c2_mid) and c2_i_live > 0
                Candle c2_proj_l = candleSet.candles.get(c2_i_live)
                Candle c3_proj_l = candleSet.candles.get(c2_i_live - 1)
                int htf_eq3_x1_l = c2_proj_l.wick_x
                int htf_eq3_x2_l = c3_proj_l.candle_right + 2
                if htf_eq3_x2_l > htf_eq3_x1_l
                    bin.lines.push(line.new(htf_eq3_x1_l, setup.c2_mid, htf_eq3_x2_l, setup.c2_mid, color = prev_eq_color, style = eq_htf_style_live, width = prev_eq_width))
            if not na(setup.c3_mid) and c2_i_live > 1
                Candle c3_proj4_l = candleSet.candles.get(c2_i_live - 1)
                Candle c4_proj_l = candleSet.candles.get(c2_i_live - 2)
                int htf_eq4_x1_l = c3_proj4_l.wick_x
                int htf_eq4_x2_l = c4_proj_l.candle_right + 2
                color htf_eq4_col_l = setup.ez_c4_invalid ? color.red : prev_eq_color
                if htf_eq4_x2_l > htf_eq4_x1_l
                    bin.lines.push(line.new(htf_eq4_x1_l, setup.c3_mid, htf_eq4_x2_l, setup.c3_mid, color = htf_eq4_col_l, style = eq_htf_style_live, width = prev_eq_width))
        if not setup.is_invalid and settings.entry_zone_show and setup.ez_c3_set and not na(setup.ez_c3_left_time)
            color ez_col_live = is_bull ? settings.entry_zone_bull_color : settings.entry_zone_bear_color
            int ez_right_live = EntryZoneRight(setup.ez_c3_right_time)
            bin.boxes.push(box.new(setup.ez_c3_left_time, setup.ez_c3_top, ez_right_live, setup.ez_c3_bot, xloc = xloc.bar_time, bgcolor = ez_col_live, border_color = color_transparent, border_width = 0))
            if settings.show_c3_lbl
                float ez_lbl_y_live = is_bull ? setup.ez_c3_bot : setup.ez_c3_top
                int ez_lbl_x_live = setup.ez_c3_left_time + timeframe.in_seconds() * 1000
                lbl_style_ez_live = is_bull ? label.style_label_up : label.style_label_down
                bin.labels.push(label.new(ez_lbl_x_live, ez_lbl_y_live, "C3", xloc = xloc.bar_time, color = color_transparent, textcolor = settings.c2_color, style = lbl_style_ez_live, size = settings.c2_size))
    candleSet

method DrawAll(CandleSet candleSet, int offset) =>
    candleSet.CalculatePositions(offset)
    candleSet.DrawVTHLLines()
    if not settings.hide_candles
        PanelFeatures(candleSet.candles, pp0_1, pp0_2, pp0_3, corr_pair1_ok, corr_pair2_ok, corr_pair3_ok)
        DrawPanelFvgs(candleSet.candles, candleSet.settings.htf)
        candleSet.DrawCandles()
        DrawPanelSmtPsp(candleSet.candles)
        candleSet.DrawLabels(offset)
        candleSet.DrawTrace(offset)
        if not settings.hide_setups
            DrawPanelCLabelsPreview(candleSet.candles, true, NO_HIST, 0, false, -1)
    if not settings.hide_setups
        candleSet.DrawSetups()
    candleSet

// ============================================================================
// Main Execution
// ============================================================================

bool calculate_on_close = input.bool(true, 'Calculate on Close?', tooltip='When enabled, live setup detection only runs when LTF candles close (better performance).', group = 'Performance')

string currentQuarterlySession = getCurrentQuarterlySession()
bool isNewQuarterlySession = currentQuarterlySession != prevQuarterlySession and currentQuarterlySession != ""
prevQuarterlySession := currentQuarterlySession

bool isNewHTFCandle = isQuarterlyMode() ? isNewQuarterlySession : ta.change(time(htf.settings.htf)) > 0


bool should_run_monitor = isNewHTFCandle or not calculate_on_close or barstate.isconfirmed

bool valid_htf = ValidTimeframe(htf.settings.htf)
bin.clear()

// ============================================================================
// FVG Engine — HTF Fair Value Gap (3-candle imbalance) — visual layer
// request.security calls MUST be top-level (Pine constraint), so they run
// unconditionally every bar; fvg_show_input only gates drawing.
// ============================================================================
string fvg_htf = fvg_auto_mode_input ? fvg_get_htf_period() : fvg_manual_htf_input
bool fvg_new_period = ta.change(time(fvg_htf)) != 0
[fvg_has_bear, fvg_has_bull, fvg_bear_bot, fvg_bear_top, fvg_bull_bot, fvg_bull_top, fvg_t1, fvg_t2] = request.security(syminfo.tickerid, fvg_htf, fvg_detect(), lookahead = barmerge.lookahead_off)
float fvg_close_val = request.security(syminfo.tickerid, fvg_htf, close, lookahead = barmerge.lookahead_off)

if fvg_new_period and not na(fvg_t1)
    string fvg_tf_str = fvg_format_tf(fvg_htf)
    if fvg_show_bear_input and fvg_has_bear and not na(fvg_bear_bot) and not na(fvg_bear_top)
        bool exists_bear = false
        if fvg_list.size() > 0
            for fi = 0 to fvg_list.size() - 1
                PoiFVG item = fvg_list.get(fi)
                if not item.is_bullish and item.top == fvg_bear_top and item.bottom == fvg_bear_bot
                    exists_bear := true
        if not exists_bear
            box b_fvg = na
            line l_fvg = na
            label lbl_fvg = na
            float mid_p = (fvg_bear_top + fvg_bear_bot) / 2
            color box_clr = fvg_show_input ? fvg_bear_color_input : color.new(fvg_bear_color_input, 100)
            if fvg_show_boxes_input
                b_fvg := box.new(fvg_t2, fvg_bear_top, time, fvg_bear_bot, bgcolor = box_clr, border_color = color.new(color.gray, 100), xloc = xloc.bar_time)
                if fvg_show_midline_input
                    l_fvg := line.new(fvg_t2, mid_p, time, mid_p, color = fvg_show_input ? fvg_midline_color_input : color.new(fvg_midline_color_input, 100), style = LineStyle(fvg_midline_style_input), width = fvg_midline_width_input, xloc = xloc.bar_time)
            if fvg_show_labels_input
                lbl_fvg := label.new(time, mid_p, "FVG-" + fvg_tf_str, color = color.new(color.white, 100), textcolor = fvg_show_input ? fvg_label_color_input : color.new(fvg_label_color_input, 100), style = label.style_label_right, size = LabelSize(fvg_label_size_input), xloc = xloc.bar_time)
            fvg_list.push(PoiFVG.new(b_fvg, l_fvg, lbl_fvg, fvg_bear_top, fvg_bear_bot, false, fvg_t2))
    if fvg_show_bull_input and fvg_has_bull and not na(fvg_bull_bot) and not na(fvg_bull_top)
        bool exists_bull = false
        if fvg_list.size() > 0
            for fj = 0 to fvg_list.size() - 1
                PoiFVG item2 = fvg_list.get(fj)
                if item2.is_bullish and item2.top == fvg_bull_top and item2.bottom == fvg_bull_bot
                    exists_bull := true
        if not exists_bull
            box b_fvg2 = na
            line l_fvg2 = na
            label lbl_fvg2 = na
            float mid_p2 = (fvg_bull_top + fvg_bull_bot) / 2
            color box_clr2 = fvg_show_input ? fvg_bull_color_input : color.new(fvg_bull_color_input, 100)
            if fvg_show_boxes_input
                b_fvg2 := box.new(fvg_t2, fvg_bull_top, time, fvg_bull_bot, bgcolor = box_clr2, border_color = color.new(color.gray, 100), xloc = xloc.bar_time)
                if fvg_show_midline_input
                    l_fvg2 := line.new(fvg_t2, mid_p2, time, mid_p2, color = fvg_show_input ? fvg_midline_color_input : color.new(fvg_midline_color_input, 100), style = LineStyle(fvg_midline_style_input), width = fvg_midline_width_input, xloc = xloc.bar_time)
            if fvg_show_labels_input
                lbl_fvg2 := label.new(time, mid_p2, "FVG+" + fvg_tf_str, color = color.new(color.white, 100), textcolor = fvg_show_input ? fvg_label_color_input : color.new(fvg_label_color_input, 100), style = label.style_label_right, size = LabelSize(fvg_label_size_input), xloc = xloc.bar_time)
            fvg_list.push(PoiFVG.new(b_fvg2, l_fvg2, lbl_fvg2, fvg_bull_top, fvg_bull_bot, true, fvg_t2))

if fvg_new_period and fvg_list.size() > 0
    for fk = fvg_list.size() - 1 to 0 by 1
        PoiFVG f = fvg_list.get(fk)
        bool fvg_invalid = f.is_bullish ? (fvg_close_val < f.bottom) : (fvg_close_val > f.top)
        if fvg_invalid
            if not na(f.fvg_box)
                box.delete(f.fvg_box)
            if not na(f.midline)
                line.delete(f.midline)
            if not na(f.fvg_label)
                label.delete(f.fvg_label)
            fvg_list.remove(fk)

if fvg_list.size() > 0
    for fm = 0 to fvg_list.size() - 1
        PoiFVG f = fvg_list.get(fm)
        color box_clr3 = fvg_show_input ? (f.is_bullish ? fvg_bull_color_input : fvg_bear_color_input) : color.new(f.is_bullish ? fvg_bull_color_input : fvg_bear_color_input, 100)
        if not na(f.fvg_box)
            box.set_bgcolor(f.fvg_box, box_clr3)
            box.set_border_color(f.fvg_box, fvg_show_input ? color.new(color.gray, 100) : color.new(color.white, 100))
            box.set_right(f.fvg_box, time)
        if not na(f.midline)
            line.set_color(f.midline, fvg_show_input ? fvg_midline_color_input : color.new(fvg_midline_color_input, 100))
            line.set_x2(f.midline, time)
        if not na(f.fvg_label)
            label.set_textcolor(f.fvg_label, fvg_show_input ? fvg_label_color_input : color.new(fvg_label_color_input, 100))
            label.set_x(f.fvg_label, time)

int fvg_total_fvgs = fvg_list.size()
if fvg_total_fvgs > fvg_max_fvgs_input
    for fn = 0 to (fvg_total_fvgs - fvg_max_fvgs_input) - 1
        PoiFVG old_fvg = fvg_list.shift()
        if not na(old_fvg.fvg_box)
            box.delete(old_fvg.fvg_box)
        if not na(old_fvg.midline)
            line.delete(old_fvg.midline)
        if not na(old_fvg.fvg_label)
            label.delete(old_fvg.fvg_label)

// ============================================================================
// Main Execution — HTF Data Collection + Drawing
// ============================================================================

int offset = settings.offset
if valid_htf
    if should_run_monitor
        htf.Monitor(isNewHTFCandle)
    htf.Update()

// ============================================================================
// HTF2 data collection
// ============================================================================

string htf2_tf = getHTF2()
bool htf2_valid = ValidTimeframe(htf2_tf)
if htf2_show_input and htf2_valid
    bool isNewHTF2Candle = ta.change(time(htf2_tf)) > 0
    if isNewHTF2Candle
        Candle c2 = Candle.new()
        c2.o := open
        c2.c := close
        c2.h := high
        c2.l := low
        c2.o_time := time
        c2.o_idx := bar_index
        c2.c_idx := bar_index
        htf2_candles.unshift(c2)
        while htf2_candles.size() > htf2_count_input
            htf2_candles.pop()
    else if htf2_candles.size() > 0
        Candle c2 = htf2_candles.first()
        if high > c2.h
            c2.h := high
        if low < c2.l
            c2.l := low
        c2.c := close
        c2.c_idx := bar_index

// ── Pair candles aligned to each panel's candles (panel SMT / PSP). Inverse pairs normalised once. ──
bool  pnl_pair_on = (htf_smt_show or htf_psp_show) and not settings.hide_candles
float pr1o = corr_inv1 ? -xo0 : xo0
float pr1h = corr_inv1 ? -xl0 : xh0
float pr1l = corr_inv1 ? -xh0 : xl0
float pr1c = corr_inv1 ? -xc0 : xc0
float pr2o = corr_inv2 ? -yo0 : yo0
float pr2h = corr_inv2 ? -yl0 : yh0
float pr2l = corr_inv2 ? -yh0 : yl0
float pr2c = corr_inv2 ? -yc0 : yc0
float pr3o = corr_inv3 ? -zo0 : zo0
float pr3h = corr_inv3 ? -zl0 : zh0
float pr3l = corr_inv3 ? -zh0 : zl0
float pr3c = corr_inv3 ? -zc0 : zc0
int   pp0_ot = valid_htf and htf.candles.size() > 0 ? htf.candles.first().o_time : na
int   pp1_ot = htf2_show_input and htf2_valid and htf2_candles.size() > 0 ? htf2_candles.first().o_time : na
SyncPairCandle(pp0_1, pnl_pair_on and corr_pair1_configured and not na(pp0_ot), pr1o, pr1h, pr1l, pr1c, pp0_ot, htf.settings.max_display + 2)
SyncPairCandle(pp0_2, pnl_pair_on and corr_pair2_configured and not na(pp0_ot), pr2o, pr2h, pr2l, pr2c, pp0_ot, htf.settings.max_display + 2)
SyncPairCandle(pp1_1, pnl_pair_on and corr_pair1_configured and not na(pp1_ot), pr1o, pr1h, pr1l, pr1c, pp1_ot, htf2_count_input + 2)
SyncPairCandle(pp1_2, pnl_pair_on and corr_pair2_configured and not na(pp1_ot), pr2o, pr2h, pr2l, pr2c, pp1_ot, htf2_count_input + 2)
SyncPairCandle(pp0_3, pnl_pair_on and corr_pair3_configured and not na(pp0_ot), pr3o, pr3h, pr3l, pr3c, pp0_ot, htf.settings.max_display + 2)
SyncPairCandle(pp1_3, pnl_pair_on and corr_pair3_configured and not na(pp1_ot), pr3o, pr3h, pr3l, pr3c, pp1_ot, htf2_count_input + 2)

// Drawing (only on last bar)
if barstate.islast or barstate.isrealtime
    if valid_htf
        htf.DrawAll(offset)
    if htf2_show_input and htf2_valid
        htf2_candles.DrawHTF2(offset)

// ============================================================================
// Dashboard — Asset, Alignment, Bias, Date
// ============================================================================

if barstate.islast and dash_show_input
    var table dash_tbl = table.new(dash_table_position(dash_vert_input, dash_horz_input), 1, 4,
         bgcolor = color.new(#000000, 100),
         border_color = dash_text_color_input,
         border_width = 1,
         frame_color = dash_text_color_input,
         frame_width = 1)

    string dash_ltf_disp = LTFName()
    string dash_htf1_disp = HTFName(htf.settings.htf)
    string dash_htf2_disp = htf2_show_input ? HTFName(htf2_tf) : "off"

    string dash_asset_str = 'Asset : ' + syminfo.ticker
    table.cell(dash_tbl, 0, 0, dash_asset_str, text_color = dash_text_color_input, bgcolor = dash_bg_color_input, text_size = size.small, text_halign = text.align_center)

    string dash_align_str = 'Alignment : ' + dash_ltf_disp + ' / ' + dash_htf1_disp + ' / ' + dash_htf2_disp + '\n\nBias : ' + settings.bias
    table.cell(dash_tbl, 0, 1, dash_align_str, text_color = dash_text_color_input, bgcolor = dash_bg_color_input, text_size = size.small, text_halign = text.align_center)

    string dash_date_str = 'Date : ' + str.format_time(time_close, 'dd MMM yyyy', syminfo.timezone)
    table.cell(dash_tbl, 0, 2, dash_date_str, text_color = dash_text_color_input, bgcolor = dash_bg_color_input, text_size = size.small, text_halign = text.align_center)

    if not valid_htf
        string dash_warn = '⚠ HTF1 (' + dash_htf1_disp + ') invalid for chart TF (' + dash_ltf_disp + ') — check Fractal settings'
        table.cell(dash_tbl, 0, 3, dash_warn, text_color = dash_bg_color_input, bgcolor = color.new(#cc0000, 0), text_size = size.small, text_halign = text.align_center)

// SMT projection runs last so it sees the final drawing budget
f_smt_project_events()