getAutoHTF2() =>
    int s = timeframe.in_seconds()
    bool is1W = timeframe.isweekly and timeframe.multiplier == 1
    bool is1M = timeframe.ismonthly and timeframe.multiplier == 1
    switch
        s == 60    => '240'
        s == 120   => '240'
        s == 180   => '90'
        s == 300   => '240'
        s == 900   => '1D'
        s == 1800  => '240'
        s == 3600  => '1W'
        s == 14400 => '1M'
        s == 86400 => '3M'
        is1W       => '12M'
        is1M       => '12M'
        s < 3600   => '240'
        => '1W'

getHTF2() =>
    switch htf2_mode_input
        "Custom" => htf2_custom_input
        => getAutoHTF2()

