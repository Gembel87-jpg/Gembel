    int currentLowTime
    int previousLowTime
    int currentHighBar
    int previousHighBar
    int currentLowBar
    int previousLowBar
    int cycleKey
    int previousCycleKey
    bool hasCurrentRange
    bool hasPreviousRange
    int version = 0          // bumps whenever anything the SMT check reads changes (opt. 1)

type SmtSweepState
    bool ready
    bool highSwept
    bool lowSwept
    float highPivotA
    float highPivotB
    float lowPivotA
    float lowPivotB
    int highTimeA
    int highTimeB
    int lowTimeA
    int lowTimeB
    int highBarA
    int highBarB
    int lowBarA
    int lowBarB

type SmtEvent
