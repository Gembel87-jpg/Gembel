BiasOk(int dir) =>
    settings.bias == 'Neutral' or (dir == 1 and settings.bias == 'Bullish') or (dir == -1 and settings.bias == 'Bearish')

// Keeps one pair candle per panel candle (matched by open time). Inverse pairs arrive normalised.
SyncPairCandle(array<HtfPairCandle> pc, bool enabled, float o, float h, float l, float c, int main_ot, int cap) =>
    if not enabled
        if pc.size() > 0
            pc.clear()
    else if not na(main_ot) and not na(o) and not na(h) and not na(l) and not na(c)
        if pc.size() == 0 or pc.first().ot != main_ot
            if pc.size() > 0
                HtfPairCandle prevp = pc.first()
                prevp.is_closed := true
            pc.unshift(HtfPairCandle.new(o, h, l, c, main_ot))
        else
            HtfPairCandle a = pc.first()
            a.h := math.max(a.h, h)
            a.l := math.min(a.l, l)
            a.c := c
        while pc.size() > cap
            pc.pop()
    0

FindPairIdx(array<HtfPairCandle> pc, int ot) =>
    int r = -1
    if not na(ot) and pc.size() > 0
        for [i, p] in pc
            if p.ot == ot
                r := i
                break
    r

ApplyPairSmt(array<Candle> src, int i, array<HtfPairCandle> pc, bool ready, bool psp) =>
    if ready and src.size() > i
        Candle cur = src.get(i)
        int pi = FindPairIdx(pc, cur.o_time)
        if pi >= 0
            HtfPairCandle p = pc.get(pi)
            if psp
                int cur_dir = cur.c > cur.o ? 1 : cur.c < cur.o ? -1 : 0
                int pair_dir = p.c > p.o ? 1 : p.c < p.o ? -1 : 0
                cur.psp := cur_dir != 0 and pair_dir != 0 and cur_dir != pair_dir
            if src.size() > i + 1
                Candle prv = src.get(i + 1)
                int ppi = FindPairIdx(pc, prv.o_time)
                if ppi >= 0
                    HtfPairCandle pp = pc.get(ppi)
                    cur.smt_bull := cur.smt_bull or (cur.l < prv.l and p.l > pp.l) or (cur.l > prv.l and p.l < pp.l)
                    cur.smt_bear := cur.smt_bear or (cur.h > prv.h and p.h < pp.h) or (cur.h < prv.h and p.h > pp.h)
    0

PanelFeatures(array<Candle> arr, array<HtfPairCandle> p1, array<HtfPairCandle> p2, array<HtfPairCandle> p3, bool ok1, bool ok2, bool ok3) =>
    for c in arr
        c.smt_bull := false
        c.smt_bear := false
        c.psp := false
    if (htf_smt_show or htf_psp_show) and arr.size() >= 1
        for i = 0 to arr.size() - 1
            ApplyPairSmt(arr, i, p1, ok1, htf_psp_show)
            ApplyPairSmt(arr, i, p2, ok2, false)
            ApplyPairSmt(arr, i, p3, ok3, false)
    0

// '+PSP' for the C2 label of candle i
PspTag(array<Candle> arr, int i) =>
    htf_psp_show and i >= 0 and i < arr.size() and arr.get(i).psp ? '+PSP' : ''

// A newer panel candle trading through the SMT candle's extreme invalidates it
PanelSmtInvalid(array<Candle> arr, int i, bool bull) =>
    bool inv = false
    if i > 0 and i < arr.size()
        Candle c = arr.get(i)
        float lvl = bull ? c.l : c.h
        for k = 0 to i - 1
            Candle nw = arr.get(k)
            inv := inv or (bull ? nw.l < lvl : nw.h > lvl)
    inv

PanelBodyColor(array<Candle> arr, int i) =>
    Candle c = arr.get(i)
    c.c > c.o ? settings.bull_body : settings.bear_body

// Positions for a preview panel (oldest left, newest right)
PanelPositions(array<Candle> arr, int x_start) =>
    int n = arr.size()
    int step = settings.width + 1
    if n > 0
        for i = n - 1 to 0
            Candle c = arr.get(i)
            c.candle_left := x_start + step * (n - 1 - i)
            c.candle_right := c.candle_left + settings.width
            c.wick_x := c.candle_left + int(settings.width / 2)
    0

// FVG between C1 and C3 of consecutive, adjacent panel candles (drawn before the candles)
DrawPanelFvgs(array<Candle> arr, string tf) =>
    int n = arr.size()
    if htf_fvg_show and n > 2
        int tf_s = str.startswith(tf, "SESSION_") ? getQuarterlyDurationSeconds(tf) : QTU.htfSeconds(normTf(tf))
        int tf_ms = na(tf_s) ? na : tf_s * 1000
        for i = 0 to n - 3
            Candle c3 = arr.get(i)
            Candle c2 = arr.get(i + 1)
            Candle c1 = arr.get(i + 2)
            bool chrono = c1.o_idx < c2.o_idx and c2.o_idx < c3.o_idx
            bool adjacent = not na(c1.c_idx) and not na(c2.c_idx) and c2.o_idx - c1.c_idx <= 1 and c3.o_idx - c2.c_idx <= 1
            bool no_void = na(tf_ms) or (c2.o_time - c1.o_time <= tf_ms * 2 and c3.o_time - c2.o_time <= tf_ms * 2)
            bool valid = chrono and adjacent and no_void
            int fvg_right = i == 0 ? c3.candle_left : c3.candle_right
            if valid and c3.l > c1.h
                bin.boxes.push(box.new(c2.candle_right, c3.l, fvg_right, c1.h, color_transparent, 1, bgcolor = color.new(htf_bull_fvg_color, 90)))
            if valid and c3.h < c1.l
                bin.boxes.push(box.new(c2.candle_right, c1.l, fvg_right, c3.h, color_transparent, 1, bgcolor = color.new(htf_bear_fvg_color, 90)))
    0

// SMT lines between consecutive panel candles
DrawPanelSmtPsp(array<Candle> arr) =>
    int n = arr.size()
    if htf_smt_show and n >= 2
        for i = 0 to n - 2
            Candle c = arr.get(i)
            Candle pv = arr.get(i + 1)
            if line.all.size() < 490 and BiasOk(-1) and c.smt_bear and not PanelSmtInvalid(arr, i, false)
                bin.lines.push(line.new(pv.wick_x, pv.h, c.wick_x, c.h, xloc = xloc.bar_index, color = htf_smt_bear_color, style = line.style_solid, width = 1))
            if line.all.size() < 490 and BiasOk(1) and c.smt_bull and not PanelSmtInvalid(arr, i, true)
                bin.lines.push(line.new(pv.wick_x, pv.l, c.wick_x, c.l, xloc = xloc.bar_index, color = htf_smt_bull_color, style = line.style_solid, width = 1))
    0

