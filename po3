// ============================================================================
// Liquidity Suite — Relevant Swings
// ============================================================================

if lq_show_swings
    string swing_htf = lq_f_bsl_auto_tf()
    int win_start = ta.valuewhen(timeframe.change(swing_htf), bar_index, lq_swing_window - 1)
    var float[] sw_hi   = array.new_float()
    var int[]   sw_hi_b = array.new_int()
    var int[]   sw_hi_t = array.new_int()
    var line[]  sw_hi_ln = array.new_line()
    var label[] sw_hi_lb = array.new_label()
    var float[] sw_lo   = array.new_float()
    var int[]   sw_lo_b = array.new_int()
    var int[]   sw_lo_t = array.new_int()
    var line[]  sw_lo_ln = array.new_line()
    var label[] sw_lo_lb = array.new_label()
    float ph = ta.pivothigh(high, lq_swing_len, lq_swing_len)
    float pl = ta.pivotlow(low, lq_swing_len, lq_swing_len)
    int pivot_bar = bar_index - lq_swing_len
    int pivot_time = time[lq_swing_len]
    if not na(ph)
        array.push(sw_hi, ph)
        array.push(sw_hi_b, pivot_bar)
        array.push(sw_hi_t, pivot_time)
        array.push(sw_hi_ln, line.new(pivot_bar, ph, bar_index, ph, xloc=xloc.bar_index, color=lq_swing_color, style=lq_f_style(lq_swing_style), width=lq_swing_width))
        array.push(sw_hi_lb, lq_swing_label_txt != "Hide" ? label.new(bar_index, ph, lq_swing_label_txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black,100), textcolor=lq_swing_color, size=size.tiny) : na)
    if not na(pl)
        array.push(sw_lo, pl)
        array.push(sw_lo_b, pivot_bar)
        array.push(sw_lo_t, pivot_time)
        array.push(sw_lo_ln, line.new(pivot_bar, pl, bar_index, pl, xloc=xloc.bar_index, color=lq_swing_color, style=lq_f_style(lq_swing_style), width=lq_swing_width))
        array.push(sw_lo_lb, lq_swing_label_txt != "Hide" ? label.new(bar_index, pl, lq_swing_label_txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(color.black,100), textcolor=lq_swing_color, size=size.tiny) : na)
    if array.size(sw_hi) > 0
        for i = array.size(sw_hi) - 1 to 0
            if array.get(sw_hi_b, i) < win_start
                line rm_ln = array.get(sw_hi_ln, i)
                label rm_lb = array.get(sw_hi_lb, i)
                array.remove(sw_hi, i)
                array.remove(sw_hi_b, i)
                array.remove(sw_hi_t, i)
                array.remove(sw_hi_ln, i)
                array.remove(sw_hi_lb, i)
                if not na(rm_ln)
                    line.delete(rm_ln)
                if not na(rm_lb)
                    label.delete(rm_lb)
    if array.size(sw_lo) > 0
        for i = array.size(sw_lo) - 1 to 0
            if array.get(sw_lo_b, i) < win_start
                line rm_ln = array.get(sw_lo_ln, i)
                label rm_lb = array.get(sw_lo_lb, i)
                array.remove(sw_lo, i)
                array.remove(sw_lo_b, i)
                array.remove(sw_lo_t, i)
                array.remove(sw_lo_ln, i)
                array.remove(sw_lo_lb, i)
                if not na(rm_ln)
                    line.delete(rm_ln)
                if not na(rm_lb)
                    label.delete(rm_lb)
    float sw_atr = ta.atr(lq_swing_atr_len)
    float sw_thresh = sw_atr * lq_atr_mult
    int nh = array.size(sw_hi)
    bool[] keep_h = array.new_bool(nh, true)
    if sw_thresh > 0 and nh > 1
        for i = 0 to nh - 2
            if array.get(keep_h, i)
                float hpi = array.get(sw_hi, i)
                for j = i + 1 to nh - 1
                    if array.get(keep_h, j) and math.abs(hpi - array.get(sw_hi, j)) <= sw_thresh
                        if hpi >= array.get(sw_hi, j)
                            array.set(keep_h, j, false)
                        else
                            array.set(keep_h, i, false)
                            break
    if nh > 0
        int kept_h = 0
        for i = 0 to nh - 1
            if array.get(keep_h, i)
                kept_h += 1
        while kept_h > lq_swing_max_levels
            int drop_h = -1
            float low_h = 1e15
            for i = 0 to nh - 1
                if array.get(keep_h, i) and array.get(sw_hi, i) < low_h
                    low_h := array.get(sw_hi, i)
                    drop_h := i
            if drop_h >= 0
                array.set(keep_h, drop_h, false)
            kept_h -= 1
    int nl = array.size(sw_lo)
    bool[] keep_l = array.new_bool(nl, true)
    if sw_thresh > 0 and nl > 1
        for i = 0 to nl - 2
            if array.get(keep_l, i)
                float lpi = array.get(sw_lo, i)
                for j = i + 1 to nl - 1
                    if array.get(keep_l, j) and math.abs(lpi - array.get(sw_lo, j)) <= sw_thresh
                        if lpi <= array.get(sw_lo, j)
                            array.set(keep_l, j, false)
                        else
                            array.set(keep_l, i, false)
                            break
    if nl > 0
        int kept_l = 0
        for i = 0 to nl - 1
            if array.get(keep_l, i)
                kept_l += 1
        while kept_l > lq_swing_max_levels
            int drop_l = -1
            float high_l = -1e15
            for i = 0 to nl - 1
                if array.get(keep_l, i) and array.get(sw_lo, i) > high_l
                    high_l := array.get(sw_lo, i)
                    drop_l := i
            if drop_l >= 0
                array.set(keep_l, drop_l, false)
            kept_l -= 1
    if nh > 0
        for i = nh - 1 to 0
            if array.get(keep_h, i)
                float lvl = array.get(sw_hi, i)
                int   pt  = array.get(sw_hi_t, i)
                line  nln = array.get(sw_hi_ln, i)
                label nlb = array.get(sw_hi_lb, i)
                if high >= lvl and high[1] < lvl
                    array.remove(sw_hi, i)
                    array.remove(sw_hi_b, i)
                    array.remove(sw_hi_t, i)
                    array.remove(sw_hi_ln, i)
                    array.remove(sw_hi_lb, i)
                    f_touch_mark(lvl, 6, pt)
                else
                    line.set_x2(nln, bar_index)
                    if not na(nlb)
                        label.set_x(nlb, bar_index)
                    f_rc_register(nln, nlb, lvl, 6, lq_swing_color, pt, false)
    if nl > 0
        for i = nl - 1 to 0
            if array.get(keep_l, i)
                float lvl = array.get(sw_lo, i)
                int   pt  = array.get(sw_lo_t, i)
                line  nln = array.get(sw_lo_ln, i)
                label nlb = array.get(sw_lo_lb, i)
                if low <= lvl and low[1] > lvl
                    array.remove(sw_lo, i)
                    array.remove(sw_lo_b, i)
                    array.remove(sw_lo_t, i)
                    array.remove(sw_lo_ln, i)
                    array.remove(sw_lo_lb, i)
                    f_touch_mark(lvl, 6, pt)
                else
                    line.set_x2(nln, bar_index)
                    if not na(nlb)
                        label.set_x(nlb, bar_index)
                    f_rc_register(nln, nlb, lvl, 6, lq_swing_color, pt, false)

