f_lq_new_kz_state(string title) =>
    kz.new(_title=title, _box=array.new_box(), _hi_line=array.new_line(), _lo_line=array.new_line(),
         _hi_label=array.new_label(), _lo_label=array.new_label(), _hi_valid=array.new_bool(), _lo_valid=array.new_bool())

f_lq_init_kz() =>
    res = array.new<kz_helper>()
    if lq_use_asia
        res.push(kz_helper.new(_kz=f_lq_new_kz_state('Asia'), session=lq_asia_session, tz=lq_session_tz, c=lq_asia_color, hi_txt=lq_asia_hi_txt, lo_txt=lq_asia_lo_txt))
    if lq_use_london
        res.push(kz_helper.new(_kz=f_lq_new_kz_state('London'), session=lq_london_session, tz=lq_session_tz, c=lq_london_color, hi_txt=lq_london_hi_txt, lo_txt=lq_london_lo_txt))
    if lq_use_ny
        res.push(kz_helper.new(_kz=f_lq_new_kz_state('New York'), session=lq_ny_session, tz=lq_session_tz, c=lq_ny_color, hi_txt=lq_ny_hi_txt, lo_txt=lq_ny_lo_txt))
    res

var array<kz_helper> lq_key_zones = f_lq_init_kz()

f_lq_del_kz(kz k) =>
    while k._box.size() > lq_max_sessions or k._hi_line.size() > lq_max_sessions or k._hi_label.size() > lq_max_sessions
        if k._box.size() > 0
            box del_b = k._box.pop()
            if not na(del_b)
                box.delete(del_b)
        if k._hi_line.size() > 0
            line del_h = k._hi_line.pop()
            line del_l = k._lo_line.pop()
            array.pop(k._hi_valid)
            array.pop(k._lo_valid)
            if not na(del_h)
                line.delete(del_h)
            if not na(del_l)
                line.delete(del_l)
        if k._hi_label.size() > 0
            label del_hl = k._hi_label.pop()
            label del_ll = k._lo_label.pop()
            if not na(del_hl)
                label.delete(del_hl)
            if not na(del_ll)
                label.delete(del_ll)

method f_lq_adjust_in_kz(kz kz_obj, color c, bool t) =>
    if t and kz_obj._box.size() > 0
        b0 = kz_obj._box.get(0)
        b0.set_right(time)
        b0.set_top(math.max(b0.get_top(), high))
        b0.set_bottom(math.min(b0.get_bottom(), low))
        color box_fill = lq_box_visible ? color.new(c, lq_box_transp) : color.new(c, 100)
        b0.set_bgcolor(box_fill)
        b0.set_border_color(box_fill)
        if kz_obj._hi_line.size() > 0
            color ln_color = lq_line_visible ? c : color.new(c, 100)
            hl0 = kz_obj._hi_line.get(0)
            hl0.set_color(ln_color)
            hl0.set_x2(bar_index)
            if high > hl0.get_y1()
                hl0.set_xy1(bar_index, high)
                hl0.set_xy2(bar_index, high)
            ll0 = kz_obj._lo_line.get(0)
            ll0.set_color(ln_color)
            ll0.set_x2(bar_index)
            if low < ll0.get_y1()
                ll0.set_xy1(bar_index, low)
                ll0.set_xy2(bar_index, low)
        if kz_obj._hi_label.size() > 0
            color lbl_color = lq_session_lbl != "Hide" ? c : lq_colors_transparent
            kz_obj._hi_label.get(0).set_textcolor(lbl_color)
            kz_obj._lo_label.get(0).set_textcolor(lbl_color)
            if high > kz_obj._hi_label.get(0).get_y()
                kz_obj._hi_label.get(0).set_xy(time, high)
            if low < kz_obj._lo_label.get(0).get_y()
                kz_obj._lo_label.get(0).set_xy(time, low)

method f_lq_adjust_out_kz(kz kz_obj, bool t) =>
    boxCount = kz_obj._box.size()
    if not t and boxCount > 0
        if kz_obj._hi_valid.get(0)
            kz_obj._hi_line.get(0).set_x2(bar_index)
            kz_obj._hi_label.get(0).set_x(time)
            if high >= kz_obj._hi_line.get(0).get_y1()
                kz_obj._hi_valid.set(0, false)
                f_touch_mark(kz_obj._hi_line.get(0).get_y1(), 2, int(kz_obj._box.get(0).get_left()))
                kz_obj._hi_label.get(0).set_x(time[3])
                if lq_alert_sessions
                    alert(kz_obj._title + ' High Touched', alert.freq_once_per_bar)
        if kz_obj._lo_valid.get(0)
            kz_obj._lo_line.get(0).set_x2(bar_index)
            kz_obj._lo_label.get(0).set_x(time)
            if low <= kz_obj._lo_line.get(0).get_y1()
                kz_obj._lo_valid.set(0, false)
                f_touch_mark(kz_obj._lo_line.get(0).get_y1(), 2, int(kz_obj._box.get(0).get_left()))
                kz_obj._lo_label.get(0).set_x(time[3])
                if lq_alert_sessions
                    alert(kz_obj._title + " Low Touched", alert.freq_once_per_bar)

method f_lq_manage_kz(kz_helper this) =>
    kz k = this._kz
    color c = this.c
    string hi_t = this.hi_txt
    string lo_t = this.lo_txt
    if timeframe.in_seconds() < timeframe.in_seconds(lq_hide_above_tf)
        bool t = not na(time("", this.session, this.tz))
        int sess_day = dayofmonth(time, this.tz)
        if k._created and sess_day != k._created_day
            k._created := false
        if t and (not k._created or k._box.size() == 0)
            color box_fill = lq_box_visible ? color.new(c, lq_box_transp) : color.new(c, 100)
            k._box.unshift(box.new(time, high, time, low, xloc=xloc.bar_time, border_color=box_fill, bgcolor=box_fill, text_color=na))
            color ln_color = lq_line_visible ? c : color.new(c, 100)
            k._hi_line.unshift(line.new(bar_index, high, bar_index, high, xloc=xloc.bar_index, style=lq_f_sess_line_style_mapped(lq_session_style), color=ln_color, width=lq_session_width))
            k._lo_line.unshift(line.new(bar_index, low, bar_index, low, xloc=xloc.bar_index, style=lq_f_sess_line_style_mapped(lq_session_style), color=ln_color, width=lq_session_width))
            array.unshift(k._hi_valid, true)
            array.unshift(k._lo_valid, true)
            color lbl_color = lq_session_lbl != "Hide" ? c : lq_colors_transparent
            k._hi_label.unshift(label.new(time, high, hi_t, xloc=xloc.bar_time, color=lq_colors_transparent, textcolor=lbl_color, style=label.style_label_down, size=lq_f_sess_text_size(lq_session_lbl), text_font_family=font.family_monospace))
            k._lo_label.unshift(label.new(time, low, lo_t, xloc=xloc.bar_time, color=lq_colors_transparent, textcolor=lbl_color, style=label.style_label_up, size=lq_f_sess_text_size(lq_session_lbl), text_font_family=font.family_monospace))
            f_lq_del_kz(k)
            k._created := true
            k._created_day := sess_day
        f_lq_adjust_in_kz(k, c, t)
        f_lq_adjust_out_kz(k, t)
        if k._hi_line.size() > 0 and k._box.size() > 0
            int reg_start = t ? 1 : 0
            int reg_max = math.min(k._hi_line.size(), k._box.size())
            int reg_i = reg_start
            while reg_i < reg_max
                int sess_start = int(k._box.get(reg_i).get_left())
                if k._hi_valid.get(reg_i)
                    f_rc_register(k._hi_line.get(reg_i), k._hi_label.get(reg_i), k._hi_line.get(reg_i).get_y1(), 2, c, sess_start, false)
                if k._lo_valid.get(reg_i)
                    f_rc_register(k._lo_line.get(reg_i), k._lo_label.get(reg_i), k._lo_line.get(reg_i).get_y1(), 2, c, sess_start, false)
                reg_i += 1

if lq_show_sessions
    for [_, value] in lq_key_zones
        f_lq_manage_kz(value)

