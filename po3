fvg_get_htf_period() =>
    int s = timeframe.in_seconds()
    switch
        s <= 15    => "5"
        s <= 60    => "15"
        s <= 180   => "30"
        s <= 300   => "60"
        s <= 600   => "150"
        s <= 900   => "240"
        s <= 1800  => "1D"
        s <= 2700  => "720"
        s <= 3600  => "1D"
        s <= 7200  => "2D"
        s <= 14400 => "1W"
        s <= 21600 => "4D"
        s <= 43200 => "1W"
        s <= 86400 => "15D"
        s <= 259200 => "45D"
        s <= 604800 => "15W"
        s <= 2592000 => "15M"
        => "45M"

fvg_format_tf(string tf) =>
    float s = timeframe.in_seconds(tf)
    string result = ""
    if s < 60
        result := str.tostring(s) + "S"
    else if (s / 60) < 60
        result := str.tostring(math.round(s / 60)) + "M"
    else if (s / 3600) < 24
        result := str.tostring(math.round(s / 3600)) + "H"
    else if (s / 86400) < 7
        result := str.tostring(math.round(s / 86400)) + "D"
    else if (s / 604800) < 4
        result := str.tostring(math.round(s / 604800)) + "W"
    else if (s / 2592000) < 12
        result := str.tostring(math.round(s / 2592000)) + "M"
    else
        result := str.tostring(math.round(s / 31536000)) + "Y"
    result

fvg_detect() =>
    bool has_bear = false
    bool has_bull = false
    float bear_bot = na
    float bear_top = na
    float bull_bot = na
    float bull_top = na
    int t_val = na
    int t2_val = na
    if barstate.isconfirmed
        float h0 = high[0]
        float l0 = low[0]
        float h2 = high[2]
        float l2 = low[2]
        int t0 = time[0]
        if not na(l2) and h0 < l2
            has_bear := true
            bear_bot := h0
            bear_top := l2
            t_val := t0
            t2_val := time[2]
        if not na(h2) and l0 > h2
            has_bull := true
            bull_bot := h2
            bull_top := l0
            t_val := t0
            t2_val := time[2]
    [has_bear, has_bull, bear_bot, bear_top, bull_bot, bull_top, t_val, t2_val]

DayofWeek(int index) =>
    switch
        index == 1 => 'M'
        index == 2 => 'T'
        index == 3 => 'W'
        index == 4 => 'T'
