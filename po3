f_prev_level(string per, bool isHigh, string lbltxt, color clr, string styleStr, int wid, int prio, bool enabled) =>
    [h1, l1, c1, o1, t1, h0, l0, c0, o0, t0, h1bar, l1bar, h0bar, l0bar] = f_bsl_mini(per)
    if enabled
        var float lv = na
        var int   lv_time = na
        var line  ln = na
        var label lb = na
        var bool  touched = false
        if not na(h1) and not na(l1)
            float nv = isHigh ? h1 : l1
            int   nb = isHigh ? h1bar : l1bar
            if timeframe.change(per)
                lv := nv
                lv_time := nb
                touched := false
                if not na(ln)
                    line.delete(ln)
                if not na(lb)
                    label.delete(lb)
                ln := na
                lb := na
                if not na(lv)
                    ln := line.new(nb, lv, time, lv, xloc=xloc.bar_time, color=clr, style=lq_f_style(styleStr), width=wid)
                    lb := label.new(time, lv, lbltxt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 100), textcolor=clr, size=size.small)
            else
                if not na(ln)
                    line.set_x2(ln, time)
                    label.set_x(lb, time)
                    if not touched
                        bool hit = isHigh ? high >= lv : low <= lv
                        if hit
                            touched := true
                            f_purge_level(ln, lb, lv, clr, prio, lv_time)
                            ln := na
                            lb := na
        if not na(ln)
            f_rc_register(ln, lb, lv, prio, clr, lv_time, false)

f_prev_level("D", true,  "PDH", lq_pd_color, lq_pd_style, lq_pd_width, 1, lq_show_pd)
f_prev_level("D", false, "PDL", lq_pd_color, lq_pd_style, lq_pd_width, 1, lq_show_pd)
