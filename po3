f_bsl_mini(string _htf) =>
    var float _h0 = high
    var float _l0 = low
    var float _o0 = open
    var int   _t0 = time
    var float _h1 = high
    var float _l1 = low
    var float _o1 = open
    var int   _t1 = time
    var int   _h0bar = time
    var int   _l0bar = time
    var int   _h1bar = time
    var int   _l1bar = time
    if timeframe.change(_htf)
        _t0 := time
        _o0 := open
        _h0 := high
        _l0 := low
    if high >= _h0
        _h0 := high
        _h0bar := time
    if low <= _l0
        _l0 := low
        _l0bar := time
    if timeframe.change(_htf)
        _o1 := _o0[1]
        _h1 := _h0[1]
        _l1 := _l0[1]
        _t1 := _t0[1]
        _h1bar := _h0bar[1]
        _l1bar := _l0bar[1]
    [_h1, _l1, close[1], _o1, _t1, _h0, _l0, close, _o0, _t0, _h1bar, _l1bar, _h0bar, _l0bar]

