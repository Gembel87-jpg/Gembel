// ============================================================================
// Intraday / Scalp / Swing Fractal Modes
// ============================================================================

getIntradayHTF() =>
    int s = timeframe.in_seconds()
    switch
        s == 60   => '15'
        s == 180  => '30'
        s == 300  => '60'
        s == 900  => '240'
        s == 1800 => '240'
        s == 3600 => '1D'
        s == 7200 => '1D'
        s == 14400 => '1D'
        s == 86400 => '1W'
        s < 3600  => '60'
        => '1D'

getScalpHTF() =>
    int s = timeframe.in_seconds()
    switch
        s <= 60   => '5'
        s <= 300  => '15'
        s <= 900  => '60'
        s <= 3600 => '240'
        => '1D'

getSwingHTF() =>
    int s = timeframe.in_seconds()
    bool is1W = timeframe.isweekly and timeframe.multiplier == 1
    switch
        s == 300   => '60'
        s == 900   => '240'
        s == 1800  => '240'
        s == 3600  => '1D'
        s == 7200  => '1D'
        s == 14400 => '1W'
        s == 86400 => '1W'
        is1W       => '1M'
        s < 3600   => '240'
        => '1D'

getFractalHTF() =>
    switch settings.fractal_mode
        "Automatic" => getHigherTF()
        "Intraday" => getIntradayHTF()
        "Scalp" => getScalpHTF()
