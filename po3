method DrawHTF2(array<Candle> h2_candles, int offset) =>
    int n2 = h2_candles.size()
    if n2 > 0
        int base2 = bar_index + offset + (settings.width + 1) * (htf.candles.size() - 1) + settings.width + htf2_gap_input
        for i = n2 - 1 to 0 by 1
            Candle pc = h2_candles.get(i)
            int pt_buffer = (settings.width + 1) * (n2 - i - 1)
            pc.candle_left := base2 + pt_buffer
            pc.candle_right := base2 + settings.width + pt_buffer
            pc.wick_x := base2 + int(settings.width / 2) + pt_buffer
        PanelFeatures(h2_candles, pp1_1, pp1_2, pp1_3, corr_pair1_ok, corr_pair2_ok, corr_pair3_ok)
        DrawPanelFvgs(h2_candles, getHTF2())
        for i = n2 - 1 to 0 by 1
            Candle candle = h2_candles.get(i)
            int t_buffer = (settings.width + 1) * (n2 - i - 1)
            int c_left = base2 + t_buffer
            int c_right = base2 + settings.width + t_buffer
            int c_wick = base2 + settings.width / 2 + t_buffer
            bool bull = candle.c > candle.o
            bin.boxes.push(box.new(c_left, math.max(candle.o, candle.c), c_right, math.min(candle.o, candle.c), bull ? settings.bull_border : settings.bear_border, 1, bgcolor = bull ? settings.bull_body : settings.bear_body))
            bin.lines.push(line.new(c_wick, candle.h, c_wick, math.max(candle.o, candle.c), xloc = xloc.bar_index, color = bull ? settings.bull_wick : settings.bear_wick))
            bin.lines.push(line.new(c_wick, math.min(candle.o, candle.c), c_wick, candle.l, xloc = xloc.bar_index, color = bull ? settings.bull_wick : settings.bear_wick))
        DrawPanelSmtPsp(h2_candles)
        if not settings.hide_setups
            DrawPanelCLabelsPreview(h2_candles, true, NO_HIST, 0, false, -1)
        // HTF2 Labels
        if htf2_label_show_input
            float h2_top = h2_candles.get(0).h
            float h2_bot = h2_candles.get(0).l
            for c in h2_candles
                if c.h > h2_top
                    h2_top := c.h
                if c.l < h2_bot
                    h2_bot := c.l
            int h2_left = base2 + (settings.width + 1) * (n2 - 1) / 2
            string h2_lbl_text = HTFName(getHTF2())
            if htf2_timer_show_input
                h2_lbl_text := h2_lbl_text + '\n\n(' + RemainingTime(getHTF2()) + ')'
            if htf2_label_position_input == 'Both' or htf2_label_position_input == 'Top'
                bin.labels.push(label.new(h2_left, h2_top, h2_lbl_text, color = color_transparent, textcolor = htf2_label_color_input, style = label.style_label_down, size = htf2_label_size_input))
            if htf2_label_position_input == 'Both' or htf2_label_position_input == 'Bottom'
                bin.labels.push(label.new(h2_left, h2_bot, h2_lbl_text, color = color_transparent, textcolor = htf2_label_color_input, style = label.style_label_up, size = htf2_label_size_input))
    h2_candles

